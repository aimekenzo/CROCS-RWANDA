# Copy this file to .env and adjust values as needed
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/crocs-rwanda
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-launch
ADMIN_SESSION_SECRET=change-this-session-secret-before-launch
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.com
SMTP_PASS=change-this-smtp-password
EMAIL_FROM="Crocs Rwanda <no-reply@example.com>"
ADMIN_ALERT_EMAIL=owner@example.com
