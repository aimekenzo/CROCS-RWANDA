  "description": "Crocs Rwanda storefront and admin dashboard.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "check:syntax": "node --check app.js && node --check js/main.js && node --check js/cart.js && node --check js/contact.js && node --check js/admin.js && node --check js/admin-login.js && node --check js/tracking.js",
    "check:email": "node scripts/email-check.js",
    "check:smoke": "node scripts/smoke.js",
    "check:e2e": "node scripts/e2e-order.js",
    "check": "npm run check:syntax && npm run check:smoke",
    "test": "npm run check:syntax"
  },
